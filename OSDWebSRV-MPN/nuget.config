<?xml version="1.0" encoding="utf-8"?>
<!--
  Airgap note: this repo is built with NO internet access. All NuGet
  dependencies are vendored under ./nuget-offline-cache (checked into
  source control), and this file restricts restore to ONLY that local
  folder. Do not add nuget.org or any other remote source here.

  To add or update a dependency, run the restore command documented in
  README.md's "Offline build (airgapped) setup" section on a machine
  WITH internet access, then commit the resulting nuget-offline-cache
  contents.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline-vendor" value="./nuget-offline-cache" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
